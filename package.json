{
  "name": "talamir-website",
  "version": "0.3.0",
  "private": true,
  "description": "TALAMIR official website — approved landing page on the token-driven identity contract",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:check": "tsx scripts/check-brand-placeholder.ts",
    "content:check": "tsx scripts/check-claims.ts",
    "boundary:check": "tsx scripts/check-boundary.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "closure:verify": "npm run format:check && npm run lint && npm run typecheck && npm run brand:check && npm run content:check && npm run boundary:check && npm run scan:secrets && npm run build && npm run test"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
