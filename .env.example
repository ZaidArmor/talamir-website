# Which brand definition to load from brand/index.ts.
# `talamir` is the approved identity and the default; `placeholder` and
# `swap-test` remain registered so the identity swap stays provable.
NEXT_PUBLIC_BRAND_ID=talamir

# Absolute site origin, used for canonicals, hreflang, Open Graph and the
# sitemap. Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://www.talamir.org

# Search-engine visibility. Fail-closed: ONLY the exact value `enabled` lifts
# the site-wide noindex, and an unapproved identity stays hidden regardless.
# Leave unset until the deployed design has been verified in production.
# NEXT_PUBLIC_PUBLIC_INDEXING=enabled

# ── Contact intake (POST /api/contact) ────────────────────────────────────────
# Fail-closed: the endpoint declines every submission until ALL of the following
# are set AND the store/mailer adapters are wired (see db/README.md). Names only
# here — real values live in Vercel's encrypted Environment Variables UI.
#
# Master switch. Only the exact value `enabled` opens intake.
# CONTACT_INTAKE_ENABLED=enabled
# Postgres connection string for a least-privilege role on contact_leads.
# CONTACT_DATABASE_URL=
# HMAC secret for the form-timing token. Long random value.
# CONTACT_FORM_SECRET=
# Server-side email provider, compatible with Vercel.
# CONTACT_EMAIL_PROVIDER=
# CONTACT_EMAIL_API_KEY=
# CONTACT_EMAIL_FROM=
# CONTACT_EMAIL_TO=sales@talamir.org      # pending mailbox confirmation
# CONTACT_EMAIL_CC=info@talamir.org       # pending mailbox confirmation
# Optional hardening / tuning.
# CONTACT_ALLOWED_ORIGINS=talamir.org,www.talamir.org
# CONTACT_RATE_MAX=5
# CONTACT_RATE_WINDOW_MS=600000
# CONTACT_MIN_FORM_MS=2500
# CONTACT_MAX_FORM_MS=1800000
